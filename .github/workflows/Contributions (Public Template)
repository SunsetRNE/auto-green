name: Backfill Contributions (Public Template)

on:
  workflow_dispatch:
    inputs:
      github_username:
        description: '你的 GitHub 用户名（用于获取账号创建日期）'
        required: true
        default: ''
      verified_email:
        description: '已在 GitHub 验证的邮箱（提交将计入贡献）'
        required: true
        default: ''
      git_author_name:
        description: 'Git 提交者名称（可留空，默认使用 GitHub 用户名）'
        required: false
        default: ''
      start_date:
        description: '开始日期 (YYYY-MM-DD)，留空则自动计算为 1 年前'
        required: false
        default: ''
      end_date:
        description: '结束日期 (YYYY-MM-DD)，留空则自动计算为昨天'
        required: false
        default: ''
      from_account_creation:
        description: '从账号创建日期开始回填（将忽略 start_date）'
        required: false
        default: false
        type: boolean
      dry_run:
        description: '仅测试运行，不实际推送'
        required: false
        default: false
        type: boolean
      force_push:
        description: '强制推送 (--force-with-lease)？仅当目标分支无协作者时使用'
        required: false
        default: false
        type: boolean

permissions:
  contents: write

jobs:
  backfill:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0  # 获取完整历史，用于检测已有提交

      - name: 安装依赖 (jq)
        run: sudo apt-get update && sudo apt-get install -y jq

      - name: 配置 Git 用户
        run: |
          AUTHOR_NAME="${{ github.event.inputs.git_author_name }}"
          if [[ -z "$AUTHOR_NAME" ]]; then
            AUTHOR_NAME="${{ github.event.inputs.github_username }}"
          fi
          git config user.name "$AUTHOR_NAME"
          git config user.email "${{ github.event.inputs.verified_email }}"
          echo "✅ Git 用户配置：$(git config user.name) <$(git config user.email)>"
          echo "⚠️ 请确认邮箱已在 https://github.com/settings/emails 中验证，否则贡献不计入"

      - name: 获取账号创建日期（若选择“从账号创建开始”）
        id: account_creation
        if: github.event.inputs.from_account_creation == true
        run: |
          USERNAME="${{ github.event.inputs.github_username }}"
          echo "正在获取用户 $USERNAME 的创建时间..."
          # 使用 GITHUB_TOKEN 提高 API 限流（从 60 次/小时 提升到 5000 次/小时）
          USER_INFO=$(curl -s -H "Authorization: Bearer ${{ secrets.GITHUB_TOKEN }}" \
            "https://api.github.com/users/$USERNAME")
          CREATED_AT=$(echo "$USER_INFO" | jq -r '.created_at')
          if [[ "$CREATED_AT" == "null" || -z "$CREATED_AT" ]]; then
            echo "❌ 无法获取账号创建时间，请检查用户名是否正确"
            exit 1
          fi
          CREATED_DATE=$(date -d "$CREATED_AT" +%Y-%m-%d)
          echo "📅 账号创建日期: $CREATED_DATE"
          echo "creation_date=$CREATED_DATE" >> $GITHUB_OUTPUT

      - name: 计算日期范围
        id: dates
        run: |
          if [[ "${{ github.event.inputs.from_account_creation }}" == "true" ]]; then
            START="${{ steps.account_creation.outputs.creation_date }}"
          else
            if [[ -n "${{ github.event.inputs.start_date }}" ]]; then
              START="${{ github.event.inputs.start_date }}"
            else
              START=$(date -d "1 year ago" +%Y-%m-%d)
            fi
          fi

          if [[ -n "${{ github.event.inputs.end_date }}" ]]; then
            END="${{ github.event.inputs.end_date }}"
          else
            END=$(date -d "yesterday" +%Y-%m-%d)
          fi

          # 验证日期格式
          date -d "$START" >/dev/null 2>&1 || { echo "❌ 无效开始日期: $START"; exit 1; }
          date -d "$END" >/dev/null 2>&1 || { echo "❌ 无效结束日期: $END"; exit 1; }
          if [[ "$START" > "$END" ]]; then
            echo "❌ 开始日期不能晚于结束日期"
            exit 1
          fi

          echo "start=$START" >> $GITHUB_OUTPUT
          echo "end=$END" >> $GITHUB_OUTPUT
          echo "📅 日期范围: $START 到 $END"

      - name: 生成缺失的历史提交
        id: generate
        run: |
          START="${{ steps.dates.outputs.start }}"
          END="${{ steps.dates.outputs.end }}"
          DRY_RUN="${{ github.event.inputs.dry_run }}"
          AUTHOR_EMAIL="${{ github.event.inputs.verified_email }}"

          total_days=0
          missing_days=0
          current="$START"

          while [[ "$(date -d "$current" +%s)" -le "$(date -d "$END" +%s)" ]]; do
            total_days=$((total_days + 1))
            # 使用 --author 精确匹配邮箱，避免时区问题
            commit_count=$(git log --author="$AUTHOR_EMAIL" \
              --after="$current 00:00:00" --before="$current 23:59:59" \
              --oneline | wc -l)

            if [[ $commit_count -gt 0 ]]; then
              echo "✅ $current 已有 $commit_count 次提交，跳过"
            else
              missing_days=$((missing_days + 1))
              echo "❌ $current 无提交，需要生成"
              if [[ "$DRY_RUN" != "true" ]]; then
                # 生成有意义的修改（避免垃圾提交）
                echo "backfill-$current: $(date -R)" >> backfill.log
                git add backfill.log
                if git commit --date="$current 12:00:00" -m "chore(backfill): add contribution for $current"; then
                  echo "✅ 已生成提交 $current"
                else
                  echo "⚠️ 提交失败，跳过"
                fi
              else
                echo "   (干运行) 将生成提交 $current"
              fi
            fi
            current=$(date -I -d "$current + 1 day")
          done

          echo "📊 统计: 总天数 $total_days，缺失天数 $missing_days"
          echo "missing=$missing_days" >> $GITHUB_OUTPUT

      - name: 推送更改（非干运行且有新提交）
        if: github.event.inputs.dry_run == false && steps.generate.outputs.missing != '0'
        run: |
          BRANCH="${{ github.ref_name }}"
          FORCE="${{ github.event.inputs.force_push }}"
          git fetch origin "$BRANCH"
          if [[ "$FORCE" == "true" ]]; then
            echo "⚠️ 使用 --force-with-lease 推送"
            git push --force-with-lease origin "$BRANCH"
          else
            if git push origin "$BRANCH"; then
              echo "✅ 推送成功"
            else
              echo "❌ 推送失败，请尝试强制推送或检查分支保护规则"
              exit 1
            fi
          fi

      - name: 无新提交跳过推送
        if: github.event.inputs.dry_run == false && steps.generate.outputs.missing == '0'
        run: echo "✅ 没有缺失的日期，无需推送"

      - name: 完成提示
        if: always()
        run: echo "🎉 执行完成，贡献图将在几分钟内刷新"
